# Variables de déploiement de la stack iapolitique (PulsarCD).
#
# Copier ce fichier en devops/.env (jamais commité) et remplacer chaque valeur CHANGE_ME.
# En pratique, .env et .env.qa se modifient depuis PulsarCD (éditeur .env de la stack ou MCP
# set_stack_env), pas sur le disque d'un serveur.
#
# Ce fichier est lu par bash (`source`) : pas d'espace autour de `=`, guillemets simples si une
# valeur contient des caractères spéciaux.
#
# Les variables dont le nom se termine par _CONNECTION_STRING, _KEY, _TOKEN, _SECRET ou _PASSWORD
# deviennent des secrets Docker au déploiement (montés dans /run/secrets, relus par le backend).
# Un secret Docker existant n'est jamais mis à jour : voir docs/ops.md, « Rotation des secrets ».
# Une variable laissée vide prend la valeur par défaut du backend (backend/src/config.rs).

# --- Routage Traefik --------------------------------------------------------------------------
# Domaine public. www.<TRAEFIK_HOST> redirige (301) vers lui. En QA, PulsarCD ajoute « qa. ».
TRAEFIK_HOST=iapolitique.fr
# Administration, accessible uniquement depuis le réseau local (dashboard-allowlist@file).
ADMIN_HOST=admin.iapolitique.fr

# --- Vérification post-déploiement (PulsarCD) --------------------------------------------------
# Sondé sur https://$TRAEFIK_HOST$DEPLOY_HEALTHCHECK_PATH après chaque déploiement.
DEPLOY_HEALTHCHECK_PATH=/api/health
# Temps laissé à la stack pour converger (migrations au démarrage de l'api).
DEPLOY_CONVERGE_TIMEOUT=300

# --- Secrets ------------------------------------------------------------------------------------
# Base PostgreSQL du cluster (réseau postgresqlcluster_internal), utilisateur propriétaire de la base.
DATABASE_CONNECTION_STRING=postgres://iapolitique_prod_app:CHANGE_ME@pg-primary:5432/iapolitique_prod?application_name=iapolitique
# Clé API Mistral (console.mistral.ai). Vide : les jobs IA restent en file.
MISTRAL_API_KEY=CHANGE_ME
# Clé HMAC des défis ALTCHA, 32 caractères minimum (ex. : openssl rand -hex 32).
ALTCHA_HMAC_KEY=CHANGE_ME_with_at_least_32_random_characters
# Jeton Bearer de l'API d'administration, 32 caractères minimum (ex. : openssl rand -hex 32).
ADMIN_API_TOKEN=CHANGE_ME_with_at_least_32_random_characters

# --- Modèle de décision (filtrage) ---------------------------------------------------------------
# Réseau overlay partagé des services LLM. Ne pas le redéfinir dans .env.qa : PulsarCD préfixe
# lui-même le nom des réseaux externes en QA (llm-net devient qa-llm-net).
LLM_NETWORK=llm-net
DECISION_SERVICE_URL=http://llamacpp-decision-service:8000/v1/systemone
# Délai maximal du filtrage synchrone par l'api, en secondes (défaut : 5) : au-delà, l'auteur voit
# « en cours de vérification » et un job réessaie.
DECISION_SERVICE_TIMEOUT_SECS=5
# Délai maximal du filtrage par les jobs du worker, en secondes (défaut : 30, au moins le délai
# ci-dessus) : une idée longue prend jusqu'à 17 s quand plusieurs dépôts arrivent ensemble.
DECISION_SERVICE_JOB_TIMEOUT_SECS=30

# --- Mistral ------------------------------------------------------------------------------------
# Point d'entrée de l'API Mistral. Vide : https://api.mistral.ai. Voir docs/juridique/memo.md
# (section Mistral) avant de passer sur https://api.eu.mistral.ai.
MISTRAL_API_BASE_URL=
MISTRAL_ANALYSIS_MODEL=mistral-large-latest
# Second avis et revue des signalements. Vide : même modèle que l'analyse.
MISTRAL_REVIEW_MODEL=
MISTRAL_EMBED_MODEL=mistral-embed
# Effort de raisonnement (reasoning_effort) : high (réflexion complète avant la réponse, plus de
# tokens de sortie, plus lent) ou none (réflexion minimale). Analyse : recherche web et
# structuration ; revue : second avis et revue des signalements. Ligne présente mais vide :
# paramètre omis (défaut de Mistral) ; ligne absente : high pour l'analyse, none pour la revue.
# Le modèle doit accepter le paramètre (sinon HTTP 400) : voir AGENTS.md §6.1.
MISTRAL_ANALYSIS_REASONING_EFFORT=high
MISTRAL_REVIEW_REASONING_EFFORT=none
# Plafond de dépense journalier, en euros (remis à zéro à minuit, heure de Paris).
MISTRAL_DAILY_BUDGET_EUR=5
# Prix unitaires en euros, par million de tokens (MTOK) ou par appel. À tenir à jour avec la grille
# tarifaire de Mistral : ils servent à estimer le coût de chaque appel et à appliquer le plafond.
MISTRAL_ANALYSIS_INPUT_EUR_PER_MTOK=2
MISTRAL_ANALYSIS_OUTPUT_EUR_PER_MTOK=6
# Vides : mêmes prix que l'analyse.
MISTRAL_REVIEW_INPUT_EUR_PER_MTOK=
MISTRAL_REVIEW_OUTPUT_EUR_PER_MTOK=
MISTRAL_EMBED_EUR_PER_MTOK=0.1
MISTRAL_WEB_SEARCH_EUR_PER_CALL=0.03

# --- Règles métier ------------------------------------------------------------------------------
# Similarité cosinus à partir de laquelle une idée est fusionnée avec une idée existante.
# Valeur initiale à calibrer sur des exemples réels (AGENTS.md §11) : en cas de doute, rester haut.
DEDUP_SIMILARITY_THRESHOLD=0.95
# Limites par empreinte anonyme (HMAC de l'IP avec le sel du jour).
RATE_LIMIT_IDEAS_PER_HOUR=5
RATE_LIMIT_IDEAS_PER_DAY=20
RATE_LIMIT_CONTRIBUTIONS_PER_DAY=20
RATE_LIMIT_REPORTS_PER_DAY=20

# --- Mentions légales (AGENTS.md §7.5) -----------------------------------------------------------
# Identité de l'éditeur (personne physique), servie par GET /api/legal et affichée sur
# /mentions-legales, /confidentialite et /regles. Non secrète mais JAMAIS dans git : à renseigner
# uniquement dans PulsarCD. Vide : les pages affichent « coordonnées momentanément indisponibles »
# et l'api journalise un avertissement au démarrage. Une ligne chacune (200, 300 et 40 caractères
# au plus) ; guillemets simples si la valeur contient des espaces, ex. LEGAL_PUBLISHER_NAME='Prénom Nom'.
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_PHONE=
# Adresses électroniques valides (sinon l'api refuse de démarrer) : contact général et demandes
# relatives aux données personnelles (RGPD).
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=

# --- Exploitation -------------------------------------------------------------------------------
# Filtre des logs (syntaxe tracing EnvFilter).
RUST_LOG=info,sqlx=warn
# Connexions PostgreSQL par processus (api et worker).
DATABASE_MAX_CONNECTIONS=10
# Jobs traités en parallèle par le worker.
WORKER_CONCURRENCY=2
# Nombre de proxys qui ajoutent une entrée à X-Forwarded-For devant l'api (Traefik seul : 1).
TRUSTED_PROXY_HOPS=1

# --- QA : devops/.env.qa (jamais commité) -------------------------------------------------------
# La stack qa-iapolitique lit ce même .env, puis .env.qa par-dessus. Sans .env.qa, la QA écrirait
# dans la base de production avec le budget de production. Contenu attendu de .env.qa :
#
#   DATABASE_CONNECTION_STRING=postgres://iapolitique_qa_app:CHANGE_ME@pg-primary:5432/iapolitique_qa?application_name=iapolitique-qa
#   MISTRAL_DAILY_BUDGET_EUR=0.5
#   ALTCHA_HMAC_KEY=<clé propre à la QA>
#   ADMIN_API_TOKEN=<jeton propre à la QA>
#
# À ne PAS mettre dans .env.qa :
#   - TRAEFIK_HOST / ADMIN_HOST : PulsarCD ajoute déjà « qa. » (qa.iapolitique.fr,
#     qa.admin.iapolitique.fr) ; une valeur dans .env.qa serait utilisée telle quelle.
#   - LLM_NETWORK : PulsarCD renomme déjà le réseau en qa-llm-net ; LLM_NETWORK=qa-llm-net
#     donnerait qa-qa-llm-net, qui n'existe pas.
