# syntax=docker/dockerfile:1.7
#
# CI image of iapolitique (AGENTS.md §9 and §13.5), service `test` of docker-compose.swarm.yml.
# PulsarCD runs, from devops/:
#   docker compose -f docker-compose.swarm.yml build test       # every static check, below
#   docker compose -f docker-compose.swarm.yml run --rm test    # cargo test against test-db
#
# Build context: the repository root (devops/Dockerfile.test.dockerignore keeps target/,
# node_modules/ and the .env files out of it).

# Keep RUST_VERSION aligned with backend/Dockerfile: clippy lints change between releases.
# Base images are pinned by digest (AGENTS.md §14.7): a tag can be moved, a digest cannot. The
# digest is that of the multi-architecture index. To upgrade, change the version and take the new
# digest from `docker buildx imagetools inspect <image>:<tag>` (first "Digest:" line), in every
# file that uses the image (frontend/Dockerfile, devops/Dockerfile.test).
ARG RUST_VERSION=1.99
ARG RUST_DIGEST=sha256:e259494b14672950a909b4c54527e19d29cae6ebf980672114c8bb85e5594e4a
ARG NODE_VERSION=22
ARG NODE_DIGEST=sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
# Keep NGINX_VERSION aligned with frontend/Dockerfile.
ARG NGINX_VERSION=1.31
ARG NGINX_DIGEST=sha256:892bb2152464f0c5d8972593a5f5afaf8054552580b699d95f8ff4af08c2d33d
# Alpine release of that nginx image (/etc/alpine-release): selects its security feed.
ARG NGINX_ALPINE_RELEASE=3.24
ARG ALPINE_VERSION=3.24
ARG ALPINE_DIGEST=sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# ---------------------------------------------------------------------------------------------
# Advisory feeds (AGENTS.md §14.7, finding SUP-2). BuildKit fetches an ADD URL at every build
# and reuses the layers that follow only while the content is unchanged: binding these files
# into the audit steps re-runs `npm audit`, `cargo deny` and `apk upgrade` whenever a new
# advisory or Alpine fix is published, even when no source changed. They leave no file behind.
# ---------------------------------------------------------------------------------------------
FROM scratch AS npm-advisories
ADD https://github.com/github/advisory-database/commits/main.atom /feed.atom

FROM scratch AS rustsec-advisories
ADD https://github.com/rustsec/advisory-db/commits/main.atom /feed.atom

FROM scratch AS alpine-secdb
ARG NGINX_ALPINE_RELEASE
ADD https://secdb.alpinelinux.org/v${NGINX_ALPINE_RELEASE}/main.json /main.json

# ---------------------------------------------------------------------------------------------
# 1. Frontend: known vulnerabilities of the runtime dependencies (npm audit, blocking from
#    "high", AGENTS.md §14.7) in its own stage, re-run at every new advisory; then ESLint +
#    Prettier, tsc, Vitest, production build, no third-party origin in it.
# ---------------------------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine@${NODE_DIGEST} AS frontend-deps
WORKDIR /app
ENV CI=true
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc* ./
RUN --mount=type=cache,id=iapolitique-npm,target=/root/.npm,sharing=locked \
    npm ci --no-audit --no-fund

FROM frontend-deps AS frontend-audit
RUN --mount=type=bind,from=npm-advisories,target=/tmp/advisories \
    npm audit --omit=dev --audit-level=high \
    && touch /frontend-audit-ok

FROM frontend-deps AS frontend-check
COPY frontend/ ./
RUN npm run lint \
    && npm run typecheck \
    && npm test \
    && npm run build \
    && npm run check:dist \
    && mkdir -p /frontend-out/api \
    && if [ -f src/api/openapi.json ]; then cp src/api/openapi.json /frontend-out/api/; fi \
    && touch /frontend-ok

# ---------------------------------------------------------------------------------------------
# 2. Frontend nginx: the HTTP contract of frontend/nginx.conf (security headers, CSP nonce,
#    caching, methods, dotfiles, security.txt with and without a contact address), checked by
#    devops/check_frontend_headers.sh against the build above. Same nginx image and same files
#    as the runtime stage of frontend/Dockerfile: keep them aligned.
# ---------------------------------------------------------------------------------------------
FROM nginx:${NGINX_VERSION}-alpine@${NGINX_DIGEST} AS frontend-headers
ARG NGINX_ALPINE_RELEASE
RUN --mount=type=bind,from=alpine-secdb,target=/tmp/secdb \
    grep -q "^${NGINX_ALPINE_RELEASE}\." /etc/alpine-release \
    && apk upgrade --no-cache \
    && rm -f /etc/nginx/conf.d/default.conf
ENV NGINX_ENVSUBST_OUTPUT_DIR=/run/nginx-generated
COPY frontend/nginx.conf /etc/nginx/nginx.conf
COPY frontend/nginx/.well-known/security.txt.template /etc/nginx/templates/.well-known/
COPY --chmod=0755 frontend/nginx/16-security-txt.envsh /docker-entrypoint.d/
COPY --from=frontend-check /app/dist /usr/share/nginx/html
COPY --chmod=0755 devops/check_frontend_headers.sh /usr/local/bin/check-frontend-headers
# The entrypoint renders security.txt, then nginx daemonizes (no "daemon off" in nginx.conf).
RUN set -eu; \
    stop_nginx() { nginx -s stop; while [ -f /run/nginx.pid ]; do sleep 0.1; done; }; \
    LEGAL_CONTACT_EMAIL=securite@example.org TRAEFIK_HOST=iapolitique.fr \
        NGINX_ENTRYPOINT_QUIET_LOGS=1 /docker-entrypoint.sh nginx; \
    check-frontend-headers http://127.0.0.1 securite@example.org; \
    stop_nginx; \
    rm -rf /run/nginx-generated; \
    LEGAL_CONTACT_EMAIL= TRAEFIK_HOST=iapolitique.fr \
        NGINX_ENTRYPOINT_QUIET_LOGS=1 /docker-entrypoint.sh nginx; \
    check-frontend-headers http://127.0.0.1; \
    stop_nginx; \
    touch /frontend-headers-ok

# ---------------------------------------------------------------------------------------------
# 3. devops: security invariants of docker-compose.swarm.yml (container hardening, networks,
#    Traefik routers and the admin port; AGENTS.md §14.4, §14.7), base images pinned by digest
#    in the Dockerfiles and the compose (§14.7), and the tests of both checkers.
# ---------------------------------------------------------------------------------------------
FROM alpine:${ALPINE_VERSION}@${ALPINE_DIGEST} AS devops-check
RUN apk add --no-cache python3 py3-yaml
# Same layout as the repository: check_image_pins.py reads ../backend and ../frontend.
WORKDIR /repo/devops
COPY backend/Dockerfile /repo/backend/Dockerfile
COPY frontend/Dockerfile /repo/frontend/Dockerfile
COPY devops/docker-compose.swarm.yml devops/Dockerfile.test devops/check_compose_security.py \
     devops/test_check_compose_security.py devops/check_image_pins.py \
     devops/test_check_image_pins.py ./
RUN PYTHONDONTWRITEBYTECODE=1 python3 check_compose_security.py \
    && PYTHONDONTWRITEBYTECODE=1 python3 check_image_pins.py \
    && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest -q test_check_compose_security.py \
        test_check_image_pins.py \
    && touch /devops-ok

# ---------------------------------------------------------------------------------------------
# 4. Backend: rustfmt, clippy, test compilation. The test binaries run later, at `docker compose
#    run`, because the integration tests need the test-db service.
# ---------------------------------------------------------------------------------------------
FROM rust:${RUST_VERSION}-trixie@${RUST_DIGEST} AS backend-test
RUN rustup component add rustfmt clippy
# cargo-deny (AGENTS.md §14.7): prebuilt release, checked against the SHA-256 published with it.
# To upgrade, take both checksums from https://github.com/EmbarkStudios/cargo-deny/releases.
ARG CARGO_DENY_VERSION=0.20.2
RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64) sum=9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f ;; \
        aarch64) sum=995c82be0defc7a025cae49a2aa2644ce8245c9a3318fc4103907c6a285e8c7d ;; \
        *) echo "no cargo-deny build for $arch" >&2; exit 1 ;; \
    esac; \
    name="cargo-deny-${CARGO_DENY_VERSION}-${arch}-unknown-linux-musl"; \
    curl -fsSL -o /tmp/cargo-deny.tar.gz \
        "https://github.com/EmbarkStudios/cargo-deny/releases/download/${CARGO_DENY_VERSION}/${name}.tar.gz"; \
    echo "$sum  /tmp/cargo-deny.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/cargo-deny.tar.gz -C /tmp; \
    install -m 0755 "/tmp/$name/cargo-deny" /usr/local/cargo/bin/cargo-deny; \
    rm -rf /tmp/cargo-deny.tar.gz "/tmp/$name"; \
    cargo deny --version
# CI profile: no incremental artifacts, line tables only (readable backtraces, smaller target/).
ENV CARGO_TERM_COLOR=always \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=line-tables-only \
    CARGO_PROFILE_TEST_DEBUG=line-tables-only \
    RUST_BACKTRACE=1
WORKDIR /src
# Witness files: without a dependency on the other stages, BuildKit would skip them entirely.
COPY --from=frontend-audit /frontend-audit-ok /tmp/frontend-audit-ok
COPY --from=frontend-check /frontend-ok /tmp/frontend-ok
COPY --from=frontend-headers /frontend-headers-ok /tmp/frontend-headers-ok
COPY --from=devops-check /devops-ok /tmp/devops-ok
# Same layout as the repository: the tests read ../prompts and ../frontend/src/api/openapi.json
# (and their own src/) at run time, at paths fixed at compile time from CARGO_MANIFEST_DIR.
COPY --from=frontend-check /frontend-out/api/ frontend/src/api/
COPY prompts/ prompts/
COPY backend/ backend/
WORKDIR /src/backend
# The registry and target/ are cache mounts at the paths cargo uses, never copied: the next build
# starts warm, even after a failed check, and only the test executables (a few hundred MB) leave
# the cache, into test-bin/, which devops/run-tests.sh runs. The ids are those of this stage only:
# backend/Dockerfile has its own, so the two builds never wait for each other's lock. The touch
# rebuilds the crate even when a source file is older than target/ (sources from an archive).
# There are no doctests (the ``` blocks in doc comments are `text`), hence no `cargo test --doc`.
RUN --mount=type=cache,id=iapolitique-cargo-registry-test,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=iapolitique-cargo-target-test,target=/src/backend/target,sharing=locked \
    <<'EOS'
set -eu
touch src/main.rs src/lib.rs build.rs
cargo fmt --check
cargo clippy --locked --all-targets -- -D warnings
# JSON messages on stdout, diagnostics rendered on stderr as usual.
cargo test --locked --no-run --message-format=json-render-diagnostics > /tmp/test-build.jsonl
mkdir test-bin
# One executable per test target (profile.test): lib-iapolitique, bin-iapolitique, test-<name>…
python3 - /tmp/test-build.jsonl test-bin <<'EOP'
import json, os, shutil, sys

messages, out = sys.argv[1], sys.argv[2]
copied = []
with open(messages, encoding="utf-8") as lines:
    for line in lines:
        msg = json.loads(line)
        if msg.get("reason") != "compiler-artifact" or not msg["profile"]["test"]:
            continue
        if not msg.get("executable"):
            continue
        target = msg["target"]
        name = f'{target["kind"][0]}-{target["name"]}'
        dest = os.path.join(out, name)
        if os.path.exists(dest):
            sys.exit(f"two test executables named {name}")
        shutil.copy2(msg["executable"], dest)
        copied.append(f'{name} <- {target["src_path"]}')
if not copied:
    sys.exit("cargo test --no-run produced no test executable")
print("\n".join(["test executables:"] + copied))
EOP
rm /tmp/test-build.jsonl
EOS

# Supply chain (AGENTS.md §14.7), blocking: RustSec advisories (fetched now), banned crates,
# crates.io as the only source. Reads the crate sources from the same registry cache mount, and
# runs again whenever the RustSec feed changes (rustsec-advisories), even if no source changed.
COPY devops/deny.toml /src/devops/deny.toml
RUN --mount=type=cache,id=iapolitique-cargo-registry-test,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=bind,from=rustsec-advisories,target=/tmp/rustsec-feed \
    cargo deny --locked --config ../devops/deny.toml check advisories bans sources

COPY --chmod=0755 devops/run-tests.sh /usr/local/bin/run-tests
ENTRYPOINT ["/usr/local/bin/run-tests"]
CMD []
