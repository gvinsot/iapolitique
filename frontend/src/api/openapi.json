{
  "openapi": "3.1.0",
  "info": {
    "title": "iapolitique API",
    "description": "API de la plateforme iapolitique : dépôt, filtrage, analyse et classement d'idées pour réduire les dépenses ou augmenter les recettes publiques.",
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/admin/session": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Checks the admin token (used by the admin pages to validate the token typed by the user).",
        "operationId": "getAdminSession",
        "responses": {
          "200": {
            "description": "Jeton valide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminSession"
                }
              }
            }
          },
          "401": {
            "description": "Jeton absent ou invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      }
    },
    "/api/altcha/challenge": {
      "get": {
        "tags": [
          "antispam"
        ],
        "summary": "A new ALTCHA proof-of-work challenge, to solve before submitting a form.",
        "operationId": "getAltchaChallenge",
        "responses": {
          "200": {
            "description": "Défi à résoudre par le widget ALTCHA (valable 20 minutes).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AltchaChallenge"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness: the process answers.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Le service répond.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ideas": {
      "post": {
        "tags": [
          "submissions"
        ],
        "summary": "Submits an idea: screened at once by the decision model, answered with its status and a\ntracking token.",
        "operationId": "submitIdea",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdeaSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Idée enregistrée et filtrée.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Consentements manquants ou vérification anti-robot invalide (`consent_required`, `altcha_*`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Texte ou champ invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Limite d'envois atteinte (`rate_limited`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service momentanément surchargé.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/ideas/{slug}/contributions": {
      "post": {
        "tags": [
          "submissions"
        ],
        "summary": "Submits an improvement or an objection to a published idea; once accepted, it triggers a\nre-analysis of the idea.",
        "operationId": "submitContribution",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Slug of the published idea.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContributionSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Contribution enregistrée et filtrée.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Consentements manquants ou vérification anti-robot invalide (`consent_required`, `altcha_*`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Idée inconnue ou non publiée (`idea_not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Texte ou type invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Limite d'envois atteinte (`rate_limited`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service momentanément surchargé.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/ideas/{slug}/reports": {
      "post": {
        "tags": [
          "submissions"
        ],
        "summary": "Reports a problem about a published idea. The report is screened, then reviewed by AI with\nthe other reports of the idea (at most once a day, at once for problematic content).",
        "operationId": "submitReport",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Slug of the published idea.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Signalement enregistré.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Déclaration de bonne foi manquante ou vérification anti-robot invalide (`good_faith_required`, `altcha_*`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Idée inconnue ou non publiée (`idea_not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Champ invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Limite d'envois atteinte (`rate_limited`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Service momentanément surchargé.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "The OpenAPI specification of this API.",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "Spécification OpenAPI.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness: the database is reachable.",
        "operationId": "getReady",
        "responses": {
          "200": {
            "description": "Le service est prêt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Base de données injoignable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/track": {
      "post": {
        "tags": [
          "tracking"
        ],
        "summary": "State of the idea, contribution or report behind a tracking token.",
        "operationId": "track",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "État du texte suivi.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackedItem"
                }
              }
            }
          },
          "404": {
            "description": "Jeton inconnu, expiré ou mal formé (`tracking_not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Corps invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requêtes atteinte (`rate_limited`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/track/delete": {
      "post": {
        "tags": [
          "tracking"
        ],
        "summary": "Deletes the text at once at its author's request (with what refers to it; see\n`db::tracked`). Idempotent: a second call confirms the deletion.",
        "operationId": "deleteTracked",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Texte supprimé.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Jeton inconnu, expiré ou mal formé (`tracking_not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Corps invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requêtes atteinte (`rate_limited`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/track/review-request": {
      "post": {
        "tags": [
          "tracking"
        ],
        "summary": "Asks for a human review of an automated decision against the text (refusal or masking),\nqueued for the administrator. One request per text.",
        "operationId": "requestHumanReview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Demande enregistrée.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackedReviewRequest"
                }
              }
            }
          },
          "404": {
            "description": "Jeton inconnu, expiré ou mal formé (`tracking_not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Aucune décision automatique à réexaminer (`review_not_available`) ou demande déjà faite (`review_already_requested`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Message invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requêtes atteinte (`rate_limited`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminLevel": {
        "type": "string",
        "description": "Administrative level targeted by an idea (§6.2 `admin_level`).",
        "enum": [
          "Etat",
          "SecuriteSociale",
          "Region",
          "Departement",
          "Intercommunalite",
          "Commune",
          "Multi"
        ]
      },
      "AdminSession": {
        "type": "object",
        "required": [
          "authenticated"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          }
        }
      },
      "AltchaChallenge": {
        "type": "object",
        "description": "Challenge sent to the widget (`GET /api/altcha/challenge`).",
        "required": [
          "algorithm",
          "challenge",
          "maxnumber",
          "salt",
          "signature"
        ],
        "properties": {
          "algorithm": {
            "type": "string",
            "description": "Always `SHA-256`.",
            "example": "SHA-256"
          },
          "challenge": {
            "type": "string",
            "description": "Hex SHA-256 of `salt` followed by the secret number."
          },
          "maxnumber": {
            "type": "integer",
            "format": "int64",
            "description": "Upper bound of the secret number.",
            "minimum": 0
          },
          "salt": {
            "type": "string",
            "description": "Random salt with its signed expiry: `<hex>?expires=<unix seconds>&`."
          },
          "signature": {
            "type": "string",
            "description": "Hex HMAC-SHA-256 of `challenge`."
          }
        }
      },
      "ContributionSubmission": {
        "type": "object",
        "description": "An improvement or an objection to a published idea (§5.5).",
        "required": [
          "kind",
          "text",
          "accept_licence",
          "accept_publication",
          "altcha"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ContributionSubmissionKind"
          },
          "text": {
            "type": "string",
            "description": "Text of the contribution, 30 to 2 000 characters. Personal data is masked before\nstorage; the text itself is never published (only its neutral summary)."
          },
          "accept_licence": {
            "type": "boolean",
            "description": "Acceptance of the licence clause of the rules (box never pre-checked)."
          },
          "accept_publication": {
            "type": "boolean",
            "description": "« Je comprends que mon texte sera publié s'il est accepté » (box never pre-checked)."
          },
          "altcha": {
            "type": "string",
            "description": "Solution of the ALTCHA widget (base64), accepted once."
          }
        },
        "additionalProperties": false
      },
      "ContributionSubmissionKind": {
        "type": "string",
        "description": "Kind of contribution a visitor may send (§5.5); duplicates are created by the pipeline.",
        "enum": [
          "Improvement",
          "Objection"
        ]
      },
      "DeletionResponse": {
        "type": "object",
        "description": "Confirmation of a deletion.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `deleted`.",
            "example": "deleted"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, in snake_case.",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "description": "Human-readable message, in French when shown to visitors.",
            "example": "Ressource introuvable."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "IdeaSubmission": {
        "type": "object",
        "description": "A new idea (§5.1).",
        "required": [
          "text",
          "accept_licence",
          "accept_publication",
          "altcha"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "Text of the idea, 50 to 4 000 characters. Personal data (e-mails, phone numbers…) is\nmasked before storage."
          },
          "admin_level": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AdminLevel",
                "description": "Administrative level targeted, if the author knows it."
              },
              {
                "type": "null"
              }
            ]
          },
          "territory": {
            "type": [
              "string",
              "null"
            ],
            "description": "Territory concerned (free text, 120 characters at most).",
            "example": "Métropole de Lyon"
          },
          "accept_licence": {
            "type": "boolean",
            "description": "Acceptance of the licence clause of the rules (box never pre-checked)."
          },
          "accept_publication": {
            "type": "boolean",
            "description": "« Je comprends que mon texte sera publié s'il est accepté » (box never pre-checked)."
          },
          "altcha": {
            "type": "string",
            "description": "Solution of the ALTCHA widget (base64), accepted once."
          }
        },
        "additionalProperties": false
      },
      "Measure": {
        "type": "string",
        "description": "Measure taken against the text.",
        "enum": [
          "Rejected",
          "Hidden"
        ]
      },
      "ReportReason": {
        "type": "string",
        "description": "Reason selected by the author of a report (§5.6): keys of `report_reasons` in\n`prompts/taxonomy.yaml`.",
        "enum": [
          "CalculationError",
          "WrongSource",
          "ProblematicContent",
          "Duplicate",
          "Other"
        ]
      },
      "ReportSubmission": {
        "type": "object",
        "description": "A report about a published idea (§5.6, §7.5).",
        "required": [
          "reason",
          "good_faith",
          "altcha"
        ],
        "properties": {
          "reason": {
            "$ref": "#/components/schemas/ReportReason"
          },
          "details": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional details, 1 000 characters at most (personal data masked). Also accepted as\n`precision`."
          },
          "reporter_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional name of the reporter (100 characters), kept 6 months, never published."
          },
          "reporter_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional e-mail of the reporter, kept 6 months, never published."
          },
          "good_faith": {
            "type": "boolean",
            "description": "Declaration of good faith (abusive reports are punished, LCEN art. 6 VII)."
          },
          "altcha": {
            "type": "string",
            "description": "Solution of the ALTCHA widget (base64), accepted once."
          }
        },
        "additionalProperties": false
      },
      "ReviewOutcome": {
        "type": "string",
        "description": "Conclusion of the AI review of the reports of an idea (§5.6).",
        "enum": [
          "Maintain",
          "Update",
          "Hide"
        ]
      },
      "ReviewRequestBody": {
        "type": "object",
        "description": "Body of a human review request.",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional message for the administrator, 1 000 characters at most (personal data\nmasked)."
          }
        },
        "additionalProperties": false
      },
      "ReviewRequestStatus": {
        "type": "string",
        "description": "State of a human review requested by an author (§7.1).",
        "enum": [
          "Pending",
          "Done"
        ]
      },
      "RuleReference": {
        "type": "object",
        "description": "Rule at stake in a decision, as sent to the author.",
        "required": [
          "article",
          "title",
          "url"
        ],
        "properties": {
          "article": {
            "type": "string",
            "description": "Article number in the rules page, e.g. `4.3`.",
            "example": "4.5"
          },
          "title": {
            "type": "string",
            "example": "Une mesure pour les finances publiques"
          },
          "url": {
            "type": "string",
            "description": "Relative link to the article, e.g. `/regles#critere-sujet`.",
            "example": "/regles#critere-sujet"
          }
        }
      },
      "StatementOfReasons": {
        "type": "object",
        "description": "Statement of reasons, given with a refusal and on the tracking page.",
        "required": [
          "measure",
          "reason_code",
          "reason_message",
          "rule",
          "automated",
          "second_opinion",
          "decided_on",
          "purge_on"
        ],
        "properties": {
          "measure": {
            "$ref": "#/components/schemas/Measure"
          },
          "reason_code": {
            "type": "string",
            "description": "`reason_code` of `prompts/screening.yaml` (refusal) or `hidden` (masking).",
            "example": "off_topic"
          },
          "reason_message": {
            "type": "string",
            "description": "Explanation in French, with an invitation to rephrase for a refusal."
          },
          "rule": {
            "$ref": "#/components/schemas/RuleReference",
            "description": "Article of the rules applied."
          },
          "automated": {
            "type": "boolean",
            "description": "The decision was taken automatically by an AI, without human review."
          },
          "second_opinion": {
            "type": "boolean",
            "description": "The decision followed a Mistral second opinion (gray zone)."
          },
          "decided_on": {
            "type": "string",
            "format": "date",
            "description": "Day of the decision (Europe/Paris)."
          },
          "purge_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Day from which the text is erased, when an erasure is scheduled."
          }
        }
      },
      "SubmissionResponse": {
        "type": "object",
        "description": "Immediate answer to a submission.",
        "required": [
          "status",
          "tracking_token",
          "reason_code",
          "reason_message",
          "statement"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Status right after the synchronous screening: `accepted`, `rejected`,\n`second_opinion` (« en cours de vérification ») or `submitted` (decision model\nunavailable: the screening is retried, follow it with the tracking link).",
            "example": "accepted"
          },
          "tracking_token": {
            "type": "string",
            "description": "Tracking token (256 bits, base64url), returned only this once: the tracking link is\n`/suivi#<token>`."
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Refusal reason (`reason_code` of `prompts/screening.yaml`)."
          },
          "reason_message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Refusal explanation in French, with an invitation to rephrase."
          },
          "statement": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/StatementOfReasons",
                "description": "Statement of reasons of a refusal (DSA art. 17)."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "TargetKind": {
        "type": "string",
        "description": "Kind of entity screened by the decision model or reachable through a tracking link.",
        "enum": [
          "Idea",
          "Contribution",
          "Report"
        ]
      },
      "TrackedIdea": {
        "type": "object",
        "description": "Published idea concerned by the tracked text.",
        "required": [
          "slug",
          "title"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "TrackedItem": {
        "type": "object",
        "description": "What the tracking page shows.",
        "required": [
          "kind",
          "status",
          "submitted_on",
          "idea",
          "decision",
          "report_outcome",
          "review_request"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/TargetKind"
          },
          "status": {
            "type": "string",
            "description": "Status of the text (`domain::status`: `submitted`, `second_opinion`, `accepted`,\n`published`, `rejected`…), or `deleted` once erased by its author.",
            "example": "accepted"
          },
          "submitted_on": {
            "type": "string",
            "format": "date",
            "description": "Day of the submission (Europe/Paris)."
          },
          "idea": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TrackedIdea",
                "description": "Published idea: the idea itself, the idea a duplicate was merged into, or the idea\nconcerned by a contribution or a report."
              },
              {
                "type": "null"
              }
            ]
          },
          "decision": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/StatementOfReasons",
                "description": "Statement of reasons of an automated decision against the text (refusal, masking)."
              },
              {
                "type": "null"
              }
            ]
          },
          "report_outcome": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReviewOutcome",
                "description": "Outcome of the AI review of a report."
              },
              {
                "type": "null"
              }
            ]
          },
          "review_request": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TrackedReviewRequest"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "TrackedReviewRequest": {
        "type": "object",
        "description": "Human review requested by the author.",
        "required": [
          "requested_on",
          "status"
        ],
        "properties": {
          "requested_on": {
            "type": "string",
            "format": "date",
            "description": "Day of the request (Europe/Paris)."
          },
          "status": {
            "$ref": "#/components/schemas/ReviewRequestStatus"
          }
        }
      },
      "TrackingRequest": {
        "type": "object",
        "description": "Body of the tracking requests.",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Tracking token (43 base64url characters), from the fragment of the tracking link."
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "admin_token": {
        "type": "http",
        "scheme": "bearer",
        "description": "ADMIN_API_TOKEN"
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Santé du service et spécification"
    },
    {
      "name": "antispam",
      "description": "Protection anti-abus des formulaires (ALTCHA)"
    },
    {
      "name": "submissions",
      "description": "Dépôt d'idées, de contributions et de signalements"
    },
    {
      "name": "tracking",
      "description": "Suivi anonyme d'un envoi par son jeton"
    },
    {
      "name": "admin",
      "description": "Administration (réseau local uniquement, jeton requis)"
    }
  ]
}
